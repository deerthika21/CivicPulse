# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (your Render static site URL in prod)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers. Include the database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/civicpulse?retryWrites=true&w=majority
# Name of the Atlas Vector Search index on the complaints collection (created in Phase 4/8)
ATLAS_VECTOR_INDEX=complaint_embedding_index

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Auth ---
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Duplicate detection ---
DUPLICATE_SIMILARITY_THRESHOLD=0.85
DUPLICATE_RADIUS_METERS=300
